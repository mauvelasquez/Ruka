NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Apify — Airbnb scraping via sourabhbgp~airbnb-scraper
# IMPORTANTE: solo en servidor, nunca exponer al cliente
APIFY_API_TOKEN=apify_api_...
APIFY_ACTOR_ID=sourabhbgp~airbnb-scraper

# Logging — Supabase Dashboard → Project Settings → API → service_role
# NUNCA usar prefijo NEXT_PUBLIC_ — esta key tiene acceso total a la DB
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin — email del usuario que puede acceder a /dashboard/logs
NEXT_PUBLIC_ADMIN_EMAIL=tu@email.com

# Verificación facial — poner false para desactivar el paso de selfie (solo OCR)
NEXT_PUBLIC_FACIAL_VERIFICATION_ENABLED=false
